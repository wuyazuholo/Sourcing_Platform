# Copy to .env.database.local and fill credentials locally. Never commit that file.
SOURCING_DB_HOST="your-sql-server"
SOURCING_DB_PORT="1433"
SOURCING_DB_NAME="XpressfeedDB"
SOURCING_DB_USER=""
SOURCING_DB_PASSWORD=""
SOURCING_DB_ENCRYPT="yes"
SOURCING_DB_TRUST_SERVER_CERTIFICATE="no"
SOURCING_DB_LOGIN_TIMEOUT="5"
SOURCING_DB_QUERY_TIMEOUT="15"
