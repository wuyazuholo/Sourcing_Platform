# 用 --env-file 显式加载；进程已有环境变量优先。密钥请放在被忽略的 .env.local。
# Anthropic-compatible（与教程相同）
ANTHROPIC_API_KEY=
MODEL_ID=
# ANTHROPIC_BASE_URL=

# OpenAI-compatible（run --provider openai）
SOURCING_MODEL_API_KEY=
SOURCING_MODEL_PROVIDER=openai
SOURCING_MODEL_NAME=deepseek-flash
SOURCING_MODEL_BASE_URL=https://api.deepseek.com
SOURCING_MODEL_REQUEST_OPTIONS='{"thinking":{"type":"disabled"}}'
SOURCING_MODEL_MAX_OUTPUT_TOKENS=4096
SOURCING_TRADE_SNAPSHOT=.runtime/data/trades.sqlite
